datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  role        Role     @default(EMPLOYEE)
  firstName   String
  lastName    String
  phoneNumber String?
  department  String?
  designation String?
  photoPath   String?  // e.g., 'uploads/profile-123.jpg'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  ADMIN
  EMPLOYEE
}
